{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "source": {
      "const": "index"
    },
    "currentness": {
      "const": "unchecked"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "case",
              "snapshot",
              "reference",
              "index",
              "query"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
          },
          "testId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^cases\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "testIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "sourcePath",
          "tags",
          "testIds"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "currentness",
    "diagnostics",
    "cases",
    "total",
    "limit",
    "offset"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-query-result.schema.json",
  "title": "TestEvidenceQueryResult"
}
