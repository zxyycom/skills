{
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ],
      "type": "string"
    },
    "state": {
      "enum": [
        "staged",
        "unchanged",
        "collection-changed",
        "definition-invalid",
        "index-path-invalid",
        "operation-aborted",
        "pending-conflict",
        "pending-write-failed",
        "revision-index-invalid",
        "revision-read-failed",
        "selection-invalid",
        "target-invalid",
        "workspace-index-invalid",
        "pending-recovery-failed"
      ],
      "type": "string"
    },
    "changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "blocking": {
                "type": "boolean"
              },
              "category": {
                "enum": [
                  "case",
                  "snapshot",
                  "reference",
                  "index",
                  "query"
                ],
                "type": "string"
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "caseId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
              },
              "testId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "blocking",
              "category",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stateId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "filesystem": {
                "type": "object",
                "properties": {
                  "causeCategory": {
                    "enum": [
                      "access-denied",
                      "not-found",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  "detail": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operation": {
                    "type": "string"
                  },
                  "target": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "causeCategory",
                  "detail",
                  "operation",
                  "target"
                ],
                "additionalProperties": false
              },
              "versionControl": {
                "type": "object",
                "properties": {
                  "causeCategory": {
                    "enum": [
                      "access-denied",
                      "busy",
                      "command-failed",
                      "not-repository",
                      "revision-unavailable",
                      "tool-unavailable",
                      "unknown"
                    ],
                    "type": "string"
                  },
                  "detail": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operation": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "target": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "causeCategory",
                  "detail",
                  "operation",
                  "target"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "code",
              "message",
              "path",
              "stateId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "indexPath": {
      "type": "string"
    },
    "namespace": {
      "const": "test-evidence"
    },
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
      }
    },
    "pending": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "no-change",
            "partial-or-unknown"
          ],
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "state",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-stage-result.schema.json",
  "title": "TestEvidenceStageResult"
}
