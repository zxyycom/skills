{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "case",
              "snapshot",
              "reference",
              "index",
              "query"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
          },
          "testId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "case": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]*$"
            },
            "sourcePath": {
              "type": "string",
              "pattern": "^cases\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
            },
            "testIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "contract": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]*$"
              },
              "minItems": 1
            },
            "proves": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]*$"
              },
              "minItems": 1
            }
          },
          "required": [
            "id",
            "title",
            "sourcePath",
            "testIds",
            "tags",
            "contract",
            "proves"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "indexPath": {
      "const": "docs/test-evidence/test-evidence-index.json"
    }
  },
  "required": [
    "schemaVersion",
    "diagnostics",
    "case",
    "markdown",
    "indexPath"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-show-result.schema.json",
  "title": "TestEvidenceShowResult"
}
