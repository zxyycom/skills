{
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "catalog",
              "config",
              "index"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "const": 3
    },
    "summary": {
      "type": "object",
      "properties": {
        "testCases": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "testCases"
      ],
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "description",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "diagnostics",
    "schemaVersion",
    "summary",
    "topics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-report.schema.json",
  "title": "TestEvidenceReport"
}
