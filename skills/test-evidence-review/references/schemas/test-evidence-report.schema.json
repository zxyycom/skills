{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "case",
              "snapshot",
              "reference",
              "index",
              "query"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "caseId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
          },
          "testId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "casePath": {
      "const": "docs/test-evidence/cases"
    },
    "indexPath": {
      "const": "docs/test-evidence/test-evidence-index.json"
    },
    "sourceRevision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entries": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "metadata": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "entries",
            "metadata"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cases",
        "tags",
        "references"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "diagnostics",
    "casePath",
    "indexPath",
    "sourceRevision",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-report.schema.json",
  "title": "TestEvidenceReport"
}
