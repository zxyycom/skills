{
  "type": "object",
  "properties": {
    "catalogPath": {
      "type": "string",
      "minLength": 1
    },
    "changed": {
      "type": "boolean"
    },
    "changedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "catalog",
              "index"
            ],
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          }
        },
        "required": [
          "blocking",
          "category",
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "indexPath": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "check",
        "write"
      ],
      "type": "string"
    },
    "schemaVersion": {
      "const": 4
    },
    "scope": {
      "enum": [
        "all",
        "selected"
      ],
      "type": "string"
    },
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}-\\d{3}$"
      }
    },
    "selectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "collection-changed",
        "current",
        "unchanged",
        "written",
        "index-invalid",
        "index-missing",
        "index-path-invalid",
        "index-read-failed",
        "index-stale",
        "index-write-failed",
        "scoped-stale",
        "selected-baseline-invalid",
        "selected-id-missing",
        "selection-invalid",
        "unselected-changes",
        "source-invalid"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ],
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "description",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "catalogPath",
    "changed",
    "changedIds",
    "diagnostics",
    "indexPath",
    "mode",
    "schemaVersion",
    "scope",
    "selectedIds",
    "selectors",
    "state",
    "status",
    "topics"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zxyycom/skills/main/skills/test-evidence-review/references/schemas/test-evidence-index-sync-result.schema.json",
  "title": "TestEvidenceIndexSyncResult"
}
