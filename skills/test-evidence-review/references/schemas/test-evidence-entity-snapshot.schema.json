{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$"
        },
        "revision": {
