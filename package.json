{
  "name": "skills-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "bun": ">=1.3.14",
    "pnpm": ">=11"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "bun scripts/lint.ts",
    "format": "oxfmt --write '{scripts/**/*.{ts,js},tools/**/*.ts}'",
    "format:check": "oxfmt --check '{scripts/**/*.{ts,js},tools/**/*.ts}'",
    "validate": "bun scripts/validate.ts",
    "test:change-plan-cli": "bun test ./tools/change-plan/tests/run.ts",
    "test:decision-records-cli": "bun test ./tools/decision-records/tests/run.ts",
    "test:check": "bun test ./scripts/vibe-check.test.ts",
    "test:environment": "bun test ./scripts/environment.test.ts ./scripts/validators/project-config.test.ts",
    "test:generated-file": "bun test ./scripts/lib/generated-file.test.ts",
    "test:skill-package-hash": "bun test ./scripts/lib/skill-package-hash.test.ts",
    "test:skill-release-publisher": "bun test ./scripts/publish-skills.test.ts",
    "test:index-runtime": "bun test ./tools/index-runtime/tests/run.ts",
    "test:relation-graph": "bun test ./tools/shared/tests/relation-graph.test.ts",
    "test:version-control": "bun test ./tools/shared/tests/version-control.test.ts",
    "test:investigation-report-check": "bun test ./tools/investigation-report/tests/run.ts",
    "test:skill-validator": "bun test ./tools/skill-validator/tests/run.ts",
    "test:task-graph-cli": "bun test ./tools/task-graph/tests/run.ts && node --test ./tools/task-graph/tests/native-store.test.ts",
    "test:test-evidence-cli": "bun test ./tools/test-evidence/tests/run.ts",
    "test:skill-updater": "bun test ./tools/skill-updater/tests/run.ts",
    "hash:skills": "bun scripts/hash-skills.ts",
    "pack:skills": "bun scripts/pack-skills.ts",
    "publish:skills": "bun scripts/publish-skills.ts",
    "change-plan": "node skills/change-plan/scripts/change-plan.mjs",
    "decision-records": "node skills/decision-records/scripts/decision-records.mjs",
    "investigation-report": "node skills/investigation-report/scripts/check-investigations.mjs",
    "setup-hooks": "node scripts/setup-git-hooks.js",
    "setup-repository": "node scripts/setup-repository.js",
    "task-graph": "node scripts/task-graph.js",
    "test-evidence": "node skills/test-evidence-review/scripts/test-evidence-catalog.mjs",
    "validate-skill": "node skills/skill-maintainer/scripts/validate-skill.mjs",
    "sync:change-plan-cli": "bun scripts/build/change-plan.ts --write",
    "check:change-plan-cli": "bun scripts/build/change-plan.ts --check",
    "sync:decision-records-cli": "bun scripts/build/decision-records.ts --write",
    "check:decision-records-cli": "bun scripts/build/decision-records.ts --check",
    "sync:skill-validator": "bun scripts/build/skill-validator.ts --write",
    "check:skill-validator": "bun scripts/build/skill-validator.ts --check",
    "sync:investigation-report-check": "bun scripts/build/investigation-report.ts --write",
    "check:investigation-report-check": "bun scripts/build/investigation-report.ts --check",
    "check:investigations": "bun tools/investigation-report/src/cli.ts --root .",
    "check:decisions": "bun tools/decision-records/src/cli.ts check --root .",
    "sync:task-graph-cli": "bun scripts/build/task-graph.ts --write",
    "check:task-graph-cli": "bun scripts/build/task-graph.ts --check",
    "check:task-graph-index": "bun tools/task-graph/src/cli.ts index info --root .",
    "sync:test-evidence-cli": "bun scripts/build/test-evidence.ts --write",
    "sync:test-evidence-catalog": "node skills/test-evidence-review/scripts/test-evidence-catalog.mjs sync-index --write --root .",
    "check:test-evidence-cli": "bun scripts/build/test-evidence.ts --check",
    "check:test-evidence-catalog": "node skills/test-evidence-review/scripts/test-evidence-catalog.mjs check --root .",
    "sync:skill-updaters": "bun scripts/build/skill-updaters.ts --write",
    "check:skill-updaters": "bun scripts/build/skill-updaters.ts --check",
    "check": "bun scripts/vibe-check.ts",
    "lint:fix": "bun scripts/lint.ts --fix",
    "fix": "bun run lint:fix && bun run format"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/picomatch": "^4.0.3",
    "@types/write-file-atomic": "4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260630.1",
    "@valibot/to-json-schema": "1.7.1",
    "@zxyycom/vibe-check": "^0.0.1",
    "ajv": "8.17.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "fs-native-extensions": "1.5.0",
    "github-slugger": "^2.0.0",
    "json-schema-to-typescript": "15.0.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mnemonist": "0.40.4",
    "neverthrow": "8.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "picomatch": "4.0.5",
    "remeda": "2.39.0",
    "simple-git": "3.36.0",
    "ts-pattern": "5.9.0",
    "valibot": "^1.4.2",
    "write-file-atomic": "8.0.0",
    "yaml": "^2.9.0"
  }
}
