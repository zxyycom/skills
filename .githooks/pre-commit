#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
git_local_env_vars="$(git rev-parse --local-env-vars)"
for variable in $git_local_env_vars; do
  unset "$variable"
done
cd "$repo_root"

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required to verify skill package versions before commit." >&2
  exit 1
fi

bun run --silent hash:skills --quiet
