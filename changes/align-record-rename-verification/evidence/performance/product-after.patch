+    await fs.writeFile(resource, "external bytes");
+    await assert.rejects(
+      verifyResourceSourceProof(root, owner, progress),
+      /Transaction member changed/
+    );
+    assert.equal(await fs.readFile(resource, "utf8"), "external bytes");
+  });
+});
