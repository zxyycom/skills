+#[test]
+fn ordinary_fan_in_orders_neighbors_before_applying_budget() {
+    use decision_records_rust_experiment::trace::{render_trace, TraceOptions};
+    let names: Vec<String> = (0..64).rev().map(|n| format!("n{n:02}")).collect();
+    let mut nodes: Vec<GraphNode<'_>> = vec![("anchor", "archived", vec![])];
+    nodes.extend(
+        names
+            .iter()
+            .map(|name| (name.as_str(), "active", vec![("修订", "anchor")])),
+    );
+    let index = graph(&nodes);
+    for budget in [1, 3] {
+        let options = TraceOptions {
+            direction: "successors".into(),
+            depth: Some(1),
+            max_records: budget,
+            json: true,
+        };
+        let output: Value =
+            serde_json::from_str(&render_trace(&index, "anchor", &options).unwrap()).unwrap();
+        let admitted: Vec<String> = std::iter::once("anchor".to_string())
+            .chain((0..budget - 1).map(|n| format!("n{n:02}")))
+            .collect();
+        let frontier: Vec<String> = (budget - 1..64).map(|n| format!("n{n:02}")).collect();
+        assert_eq!(output["traceIds"], json!(admitted));
+        assert_eq!(output["contextIds"], json!([]));
+        assert_eq!(
+            output["frontier"],
+            json!([{"fromId":"anchor","direction":"successors","reason":"max-records","nextIds":frontier}])
+        );
+        assert!(output.get("blockedEvent").is_none() || output["blockedEvent"].is_null());
+    }
+}
