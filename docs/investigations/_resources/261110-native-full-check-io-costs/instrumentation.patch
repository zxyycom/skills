+use std::{collections::BTreeMap, sync::{Mutex, OnceLock}, time::Instant};
+#[derive(Default, serde::Serialize)]
+struct Stat { calls: u64, entries: u64, nanos: u128 }
+static STATS: OnceLock<Mutex<BTreeMap<String,Stat>>> = OnceLock::new();
+fn add(name: String, entries: u64, nanos: u128, calls: u64) {
+ let mut stats=STATS.get_or_init(||Mutex::new(BTreeMap::new())).lock().unwrap();
+ let stat=stats.entry(name).or_default();stat.calls+=calls;stat.entries+=entries;stat.nanos+=nanos;
+}
+pub struct Timer { name: String, start: Instant }
+pub fn timer(name: impl Into<String>) -> Timer { Timer { name: name.into(), start: Instant::now() } }
+impl Drop for Timer { fn drop(&mut self) { add(self.name.clone(),0,self.start.elapsed().as_nanos(),1); } }
+pub fn entries(name: String, count: usize) { add(name,count as u64,0,0); }
+pub fn dump() { let stats=STATS.get_or_init(||Mutex::new(BTreeMap::new())).lock().unwrap(); eprintln!("RECORD_PROBE {}",serde_json::to_string(&*stats).unwrap()); }
